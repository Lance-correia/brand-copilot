{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-copilot.local/schema/Message.schema.json",
  "title": "Message",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]+$"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ]
    },
    "text": {
      "type": "string"
    },
    "attachmentAssetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ast_[A-Za-z0-9_-]+$"
      }
    },
    "designIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^des_[A-Za-z0-9_-]+$"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "role",
    "text",
    "attachmentAssetIds",
    "designIds",
    "steps",
    "createdAt"
  ],
  "additionalProperties": false
}
