{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-copilot.local/schema/LintViolation.schema.json",
  "title": "LintViolation",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "layerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    },
    "fix": {
      "type": "array",
      "items": {
        "$ref": "EditOp.schema.json"
      }
    }
  },
  "required": [
    "ruleId",
    "severity",
    "layerId",
    "message",
    "fix"
  ],
  "additionalProperties": false
}
