{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-copilot.local/schema/Design.schema.json",
  "title": "Design",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^des_[A-Za-z0-9_-]+$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "background": {
      "$ref": "#/$defs/Background"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "Layer.schema.json"
      }
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "parentId": {
      "type": "string",
      "pattern": "^des_[A-Za-z0-9_-]+$"
    },
    "provenance": {
      "$ref": "#/$defs/DesignProvenance"
    },
    "quality": {
      "$ref": "#/$defs/DesignQuality"
    }
  },
  "required": [
    "id",
    "workspaceId",
    "name",
    "width",
    "height",
    "background",
    "layers"
  ],
  "additionalProperties": false,
  "$defs": {
    "Background": {
      "type": "object",
      "properties": {
        "colorToken": {
          "type": "string"
        }
      },
      "required": [
        "colorToken"
      ],
      "additionalProperties": false
    },
    "DesignProvenance": {
      "type": "object",
      "properties": {
        "referenceAssetId": {
          "type": "string",
          "pattern": "^ast_[A-Za-z0-9_-]+$"
        },
        "cleanPlateAssetId": {
          "type": "string",
          "pattern": "^ast_[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "referenceAssetId"
      ],
      "additionalProperties": false
    },
    "QualityFinding": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "layerId": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "additionalProperties": false
    },
    "DesignQuality": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "needs_review"
          ]
        },
        "checkedAt": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QualityFinding"
          }
        }
      },
      "required": [
        "status",
        "checkedAt",
        "checks",
        "findings"
      ],
      "additionalProperties": false
    }
  }
}
