{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-copilot.local/schema/DesignSpec.schema.json",
  "title": "DesignSpec",
  "type": "object",
  "properties": {
    "aspect": {
      "type": "string"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "background",
              "hero",
              "headline",
              "subhead",
              "body",
              "cta",
              "cta_bg",
              "logo",
              "decoration"
            ]
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "required": [
          "role",
          "box"
        ],
        "additionalProperties": false
      }
    },
    "hierarchy": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "background",
          "hero",
          "headline",
          "subhead",
          "body",
          "cta",
          "cta_bg",
          "logo",
          "decoration"
        ]
      }
    },
    "mood": {
      "type": "string"
    },
    "imageryStyle": {
      "type": "string"
    },
    "observedColors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "aspect",
    "regions",
    "hierarchy",
    "mood",
    "imageryStyle",
    "observedColors"
  ],
  "additionalProperties": false
}
